# Copie este arquivo para .env (o `make setup` faz isso sozinho).
# Credenciais simples apenas para desenvolvimento local. Nunca use em produção.
MYSQL_HOST=127.0.0.1
# Se a porta 3306 já estiver ocupada por um MySQL instalado no computador, use 3307.
MYSQL_PORT=3306
MYSQL_DATABASE=cantina_inteligente
MYSQL_USER=cantina_app
MYSQL_PASSWORD=masterkey
MYSQL_ROOT_PASSWORD=masterkey

# Chave que assina o cookie de login. Deixe vazio: o `make setup` gera uma
# chave aleatória no seu .env.
SECRET_KEY=

# Administrador de demonstração, criado por `make admin`.
# Deixe ADMIN_SENHA vazio: o `make setup` gera uma senha no seu .env
# (você pode trocá-la lá; mínimo de 8 caracteres, com letra e número).
ADMIN_NOME=Administrador da Cantina
ADMIN_MATRICULA=100001
ADMIN_CPF=52998224725
ADMIN_EMAIL=admin@cantina.local
ADMIN_SENHA=

# Cliente de demonstração, criado por `make demo` com R$ 50,00 de crédito.
CLIENTE_NOME=Cliente de Demonstração
CLIENTE_MATRICULA=200001
CLIENTE_CPF=12345678909
CLIENTE_EMAIL=cliente@cantina.local
CLIENTE_SENHA=

# Endereço em que o servidor escuta. 127.0.0.1 = só este computador.
# Para abrir pelo celular na mesma rede Wi-Fi, use 0.0.0.0 e preencha URL_PUBLICA.
APP_HOST=127.0.0.1

# Endereço do sistema que vai dentro dos QR Codes, por exemplo http://192.168.0.10:5000.
# Vazio = usa o endereço pelo qual o administrador está acessando.
URL_PUBLICA=

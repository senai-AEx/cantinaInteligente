# Configurações da Cantina Inteligente.
# Não precisa editar este arquivo: o "python instalar.py" copia ele para .env
# e preenche sozinho os campos vazios (senhas e chave de segurança).

# Banco de dados: o MySQL 8 instalado no seu computador
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cantina_inteligente
MYSQL_USER=cantina_app
# Deixe vazio: o instalar cria a senha do usuário do sistema.
MYSQL_PASSWORD=

# Chave que assina o login. Deixe vazia: o instalar gera uma.
SECRET_KEY=

# Administrador de demonstração (criado pelo instalar)
ADMIN_NOME=Administrador da Cantina
ADMIN_MATRICULA=100001
ADMIN_CPF=52998224725
ADMIN_EMAIL=admin@cantina.local
# Deixe vazio: o instalar gera a senha. Para trocar, escreva uma com 8 ou mais
# caracteres, com letras e números, e rode: python scripts/criar_admin.py
ADMIN_SENHA=

# Cliente de demonstração (criado pelo instalar, com R$ 50,00 de crédito)
CLIENTE_NOME=Cliente de Demonstração
CLIENTE_MATRICULA=200001
CLIENTE_CPF=12345678909
CLIENTE_EMAIL=cliente@cantina.local
CLIENTE_SENHA=

# Endereço em que o sistema escuta. 127.0.0.1 = só este computador.
# Para abrir pelo celular na mesma rede Wi-Fi, use 0.0.0.0 (veja o README).
APP_HOST=127.0.0.1

# Endereço que vai dentro dos QR Codes, por exemplo http://192.168.0.10:5000.
# Vazio = usa o endereço pelo qual o administrador está acessando.
URL_PUBLICA=
